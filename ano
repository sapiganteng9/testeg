-- ===== REMOTE FUNCTIONS =====

local function getRemoteFolder()
    for _, v in pairs(ReplicatedStorage:GetChildren()) do
        if v:IsA("Folder") and v.Name:match("r%x+") then
            for _, remote in pairs(v:GetChildren()) do
                if remote:IsA("RemoteFunction") then
                    return v
                end
            end
        end
    end
    return nil
end

-- ===== DUPE FUNCTIONS =====

local function dupeBibitItems()
    updateStatus("🔄 Scanning Bibit items...")
    
    local folder = getRemoteFolder()
    if not folder then
        updateStatus("❌ Error: Folder not found!")
        return
    end
    
    local bibitsRemote = nil
    
    -- Cari bibit remote
    for _, remote in pairs(folder:GetChildren()) do
        if remote:IsA("RemoteFunction") then
            local success = pcall(function()
                local result = remote:InvokeServer("BibitPisang")
                if result and result.ok then
                    bibitsRemote = remote
                    return true
                end
            end)
            if bibitsRemote then break end
        end
    end
    
    if not bibitsRemote then
        updateStatus("❌ Error: Bibit remote not found!")
        return
    end
    
    updateStatus("⏳ Duplicating Bibit...")
    
    -- Hanya 3 Bibit yang tersedia
    local bibits = {
        "BibitPisang",
        "BibitKamboja",
        "BibitMelati"
    }
    
    local totalDuplicated = 0
    
    for _, bibitName in pairs(bibits) do
        pcall(function()
            for i = 1, 20 do -- Duplikat 20x setiap bibit
                local result = bibitsRemote:InvokeServer(bibitName)
                if result and result.ok then
                    totalDuplicated = totalDuplicated + 1
                end
                task.wait(0.05)
            end
        end)
    end
    
    updateItems(totalDuplicated)
    updateStatus("✅ Duplicated " .. totalDuplicated .. " Bibit!")
    updateAction("Bibit Duplication Complete")
end

