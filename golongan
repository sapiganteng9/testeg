-- ==========================================
-- CHECKBOX
-- ==========================================
local checkboxButtons = {}

local function createCheckbox(displayName, spawnName)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 35)
    button.BackgroundColor3 = COLOR.panelAlt
    button.TextColor3 = COLOR.textOnBlack
    button.TextSize = 13
    button.Font = Enum.Font.Gotham
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.Parent = list

    checkboxButtons[spawnName] = button

    local function update()
        if selectedMaterials[spawnName] then
            button.Text = "☑  " .. displayName
            button.BackgroundColor3 = COLOR.buttonOn
            button.TextColor3 = COLOR.textOnWhite
        else
            button.Text = "☐  " .. displayName
            button.BackgroundColor3 = COLOR.panelAlt
            button.TextColor3 = COLOR.textOnBlack
        end
    end

    button.MouseButton1Click:Connect(function()
        selectedMaterials[spawnName] = not selectedMaterials[spawnName]
        update()
    end)

    update()
end

for displayName, spawnName in pairs(materials) do
    createCheckbox(displayName, spawnName)
end

