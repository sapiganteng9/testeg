-- ==========================================
-- UPDATE CHECKBOX
-- ==========================================
local function updateAllCheckboxes()
    for displayName, spawnName in pairs(materials) do
        local button = checkboxButtons[spawnName]
        if button then
            if selectedMaterials[spawnName] then
                button.Text = "☑  " .. displayName
                button.BackgroundColor3 = COLOR.buttonOn
                button.TextColor3 = COLOR.textOnWhite
            else
                button.Text = "☐  " .. displayName
                button.BackgroundColor3 = COLOR.panelAlt
                button.TextColor3 = COLOR.textOnBlack
            end
        end
    end
end

