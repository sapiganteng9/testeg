-- LocalScript: teleport_gui.lua
-- Letakkan di StarterPlayer > StarterPlayerScripts
-- Membuat GUI di PlayerGui dan menyediakan tombol teleport ke rak & MejaMakan

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- CONFIG
local TELEPORT_TWEEN_TIME = 0.45
local TELEPORT_VERTICAL_OFFSET = 3
local AUTO_CYCLE_DELAY = 2.0

-- UI CONFIG
local UI_NAME = "TeleportRackGUI"

-- Utility: find descendants by name (case-insensitive)
local function findFirstByNameCaseInsensitive(root, name)
    local lname = name:lower()
    for _, obj in ipairs(root:GetDescendants()) do
        if obj.Name:lower() == lname then
            return obj
        end
    end
    return nil
end

-- Cari MejaMakan di seluruh workspace (case-insensitive)
local function findMejaMakanPart()
    local targetName = "mejamakan"
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name:lower():match("^" .. targetName .. "$") then
            if obj:IsA("BasePart") then
                return obj
            elseif obj:IsA("Model") then
                if obj.PrimaryPart then return obj.PrimaryPart end
                for _, c in ipairs(obj:GetChildren()) do
                    if c:IsA("BasePart") then return c end
                end
            end
        end
    end
    -- fallback: contains the word "meja" and "makan"
    for _, obj in ipairs(workspace:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("meja") and n:find("makan") then
            if obj:IsA("BasePart") then return obj end
            if obj:IsA("Model") then
                if obj.PrimaryPart then return obj.PrimaryPart end
                for _, c in ipairs(obj:GetChildren()) do
                    if c:IsA("BasePart") then return c end
                end
            end
        end
    end
    return nil
end

-- Ambil daftar target rak dari folder workspace.rak (case-insensitive)
local function getRackTargets()
    local root = workspace:FindFirstChild("rak") or workspace:FindFirstChild("Rak")
    if not root then
        -- fallback: cari folder bernama rak di descendants
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Folder") and obj.Name:lower() == "rak" then
                root = obj
                break
            end
        end
    end
    if not root then
        return {}
    end

    local seen = {}
    local targets = {}

    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            local targetPart = nil
            if parent:IsA("BasePart") then
                targetPart = parent
            elseif parent:IsA("Model") then
                targetPart = parent.PrimaryPart
                if not targetPart then
                    for _, c in ipairs(parent:GetChildren()) do
                        if c:IsA("BasePart") then
                            targetPart = c
                            break
                        end
                    end
                end
            end
            if targetPart and not seen[targetPart] then
                table.insert(targets, targetPart)
                seen[targetPart] = true
            end
        elseif obj:IsA("BasePart") and obj.Name:lower():find("rak") then
            if not seen[obj] then
                table.insert(targets, obj)
                seen[obj] = true
            end
        end
    end

    -- juga periksa children langsung di root
    for _, child in ipairs(root:GetChildren()) do
        if child:IsA("Model") then
            local candidate = child.PrimaryPart
            if not candidate then
                for _, c in ipairs(child:GetChildren()) do
                    if c:IsA("BasePart") then
                        candidate = c
                        break
                    end
                end
            end
            if candidate and not seen[candidate] then
                table.insert(targets, candidate)
                seen[candidate] = true
            end
        elseif child:IsA("BasePart") and not seen[child] then
            table.insert(targets, child)
            seen[child] = true
        end
    end

    return targets
end

-- Teleport character ke part dengan tween halus
local function teleportCharacterToPart(part)
    if not part or not part:IsA("BasePart") then return end
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    local targetCFrame = part.CFrame + Vector3.new(0, TELEPORT_VERTICAL_OFFSET, 0)
    local tweenInfo = TweenService:New(TweenInfo.new(TELEPORT_TWEEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
    local ok, err = pcall(function()
        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
        tween:Play()
    end)
    if not ok then
        hrp.CFrame = targetCFrame
    end
end

-- GUI creation
local function createGui()
    -- if already exists, reuse
    local existing = playerGui:FindFirstChild(UI_NAME)
    if existing then existing:Destroy() end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = UI_NAME
    screenGui.ResetOnSpawn = false
    screenGui.Parent = playerGui

    -- Frame
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 240, 0, 130)
    frame.Position = UDim2.new(0, 12, 0, 12)
    frame.BackgroundTransparency = 0.15
    frame.BackgroundColor3 = Color3.fromRGB(30,30,30)
    frame.BorderSizePixel = 0
    frame.Parent = screenGui

    -- Title
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -12, 0, 28)
    title.Position = UDim2.new(0, 6, 0, 6)
    title.BackgroundTransparency = 1
    title.Text = "Teleport - Rak & MejaMakan"
    title.TextColor3 = Color3.fromRGB(255,255,255)
    title.TextScaled = false
    title.Font = Enum.Font.SourceSansBold
    title.TextSize = 16
    title.Parent = frame

    -- Status label
    local status = Instance.new("TextLabel")
    status.Name = "StatusLabel"
    status.Size = UDim2.new(1, -12, 0, 20)
    status.Position = UDim2.new(0, 6, 0, 36)
    status.BackgroundTransparency = 1
    status.Text = "Loading targets..."
    status.TextColor3 = Color3.fromRGB(200,200,200)
    status.Font = Enum.Font.SourceSans
    status.TextSize = 14
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.Parent = frame

    -- Buttons
    local btnNext = Instance.new("TextButton")
    btnNext.Size = UDim2.new(1, -12, 0, 28)
    btnNext.Position = UDim2.new(0, 6, 0, 62)
    btnNext.Text = "Teleport: Next Rak (F)"
    btnNext.Font = Enum.Font.SourceSansBold
    btnNext.TextSize = 14
    btnNext.TextColor3 = Color3.fromRGB(255,255,255)
    btnNext.BackgroundColor3 = Color3.fromRGB(60,60,60)
    btnNext.BorderSizePixel = 0
    btnNext.Parent = frame

    local btnMeja = Instance.new("TextButton")
    btnMeja.Size = UDim2.new(1, -12, 0, 28)
    btnMeja.Position = UDim2.new(0, 6, 0, 96)
    btnMeja.Text = "Teleport: MejaMakan"
    btnMeja.Font = Enum.Font.SourceSansBold
    btnMeja.TextSize = 14
    btnMeja.TextColor3 = Color3.fromRGB(255,255,255)
    btnMeja.BackgroundColor3 = Color3.fromRGB(40,90,60)
    btnMeja.BorderSizePixel = 0
    btnMeja.Parent = frame

    return {
        ScreenGui = screenGui,
        Frame = frame,
        Status = status,
        BtnNext = btnNext,
        BtnMeja = btnMeja,
    }
end

-- Controller state
local targets = {}
local currentIndex = 1
local autoCycle = false
local autoCoroutine = nil

local function refreshTargets()
    targets = getRackTargets()
    if #targets == 0 then currentIndex = 1 end
    if currentIndex > #targets then currentIndex = 1 end
end

local function teleportNext()
    refreshTargets()
    if #targets == 0 then return end
    if currentIndex > #targets then currentIndex = 1 end
    local target = targets[currentIndex]
    if target then
        teleportCharacterToPart(target)
    end
    currentIndex = currentIndex + 1
    if currentIndex > #targets then currentIndex = 1 end
end

local function startAutoCycle()
    if autoCoroutine then return end
    autoCycle = true
    autoCoroutine = coroutine.create(function()
        while autoCycle do
            teleportNext()
            local t = 0
            while t < AUTO_CYCLE_DELAY and autoCycle do
                local dt = RunService.Heartbeat:Wait()
                t = t + dt
            end
        end
    end)
    coroutine.resume(autoCoroutine)
end

local function stopAutoCycle()
    autoCycle = false
    autoCoroutine = nil
end

-- Setup GUI and connections
local ui = createGui()
local statusLabel = ui.Status
local btnNext = ui.BtnNext
local btnMeja = ui.BtnMeja

-- Update UI status periodically
spawn(function()
    while true do
        refreshTargets()
        local count = #targets
        local autoText = autoCycle and "ON" or "OFF"
        statusLabel.Text = string.format("Rak targets: %d    | Auto: %s", count, autoText)
        wait(0.7)
    end
end)

-- Button actions
local clickDebounce = false
btnNext.MouseButton1Click:Connect(function()
    if clickDebounce then return end
    clickDebounce = true
    teleportNext()
    wait(0.25)
    clickDebounce = false
end)

btnMeja.MouseButton1Click:Connect(function()
    if clickDebounce then return end
    clickDebounce = true
    local meja = findMejaMakanPart()
    if meja then
        teleportCharacterToPart(meja)
    else
        -- show temporary message
        statusLabel.Text = "MejaMakan tidak ditemukan!"
        wait(1.2)
    end
    wait(0.25)
    clickDebounce = false
end)

-- Keybinds: F = next, R = toggle auto
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F then
        teleportNext()
    elseif input.KeyCode == Enum.KeyCode.R then
        if autoCycle then
            stopAutoCycle()
        else
            startAutoCycle()
        end
    end
end)

-- Refresh targets when workspace.rak perubahan
local function connectRakChanges()
    local rakFolder = workspace:FindFirstChild("rak") or workspace:FindFirstChild("Rak")
    if rakFolder then
        rakFolder.DescendantAdded:Connect(function() refreshTargets() end)
        rakFolder.DescendantRemoving:Connect(function() refreshTargets() end)
        rakFolder.ChildAdded:Connect(function() refreshTargets() end)
        rakFolder.ChildRemoved:Connect(function() refreshTargets() end)
    end
end
connectRakChanges()

-- Ensure PlayerGui resets on respawn, re-create UI if needed
player.CharacterAdded:Connect(function()
    -- ensure UI exists
    if not playerGui:FindFirstChild(UI_NAME) then
        createGui()
    end
end)

-- Initial refresh
refreshTargets()
