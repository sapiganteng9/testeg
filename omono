-- Fungsi untuk mencari lokasi di Kios
local function findLocationInKios(locationName)
    local kios = workspace:FindFirstChild("KiosAktif")
    if not kios then return nil end
    
    local function searchInFolder(folder)
        for _, child in ipairs(folder:GetChildren()) do
            if child.Name == locationName then
                if child:IsA("BasePart") then
                    return child
                elseif child:IsA("Folder") or child:IsA("Model") then
                    local part = searchInFolder(child)
                    if part then return part end
                end
            end
            if child:IsA("Folder") or child:IsA("Model") then
                local part = searchInFolder(child)
                if part then return part end
            end
        end
        return nil
    end
    
    return searchInFolder(kios)
end

-- Fungsi untuk teleport
local function teleportToLocation(locationName)
    local location = findLocationInKios(locationName)
    if location then
        humanoidRootPart.CFrame = location.CFrame + Vector3.new(0, 3, 0)
        return true
    end
    return false
end

-- Fungsi untuk mendapatkan daftar target yang dipilih
local function getSelectedTargets()
    local targets = {}
    for target, _ in pairs(selectedTargets) do
        table.insert(targets, target)
    end
    return targets
end

-- Main Loop
local lastTeleportTime = 0
RunService.Heartbeat:Connect(function()
    if isActive then
        local now = tick()
        if now - lastTeleportTime >= TELEPORT_DELAY then
            local targets = getSelectedTargets()
            if #targets > 0 then
                local randomTarget = targets[math.random(1, #targets)]
                if teleportToLocation(randomTarget) then
                    print("Teleported to: " .. randomTarget)
                else
                    print("Failed to find location: " .. randomTarget)
                end
                lastTeleportTime = now
            end
        end
    end
end)

