-- helper: get display name for a target part
local function getTargetDisplayName(part)
    if not part then return "Unknown" end
    if part.Parent and part.Parent:IsA("Model") and part.Parent.Name ~= "" then
        return part.Parent.Name
    end
    return part.Name or "Part"
end

local function updateRackListUI()
    -- clear non-layout children
    for _, child in ipairs(rackList:GetChildren()) do
        if not (child:IsA("UIListLayout") or child:IsA("UIPadding") or child:IsA("UICorner")) then
            child:Destroy()
        end
    end

    for idx, target in ipairs(rackTargets) do
        local name = getTargetDisplayName(target)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 28)
        btn.BackgroundColor3 = (idx == currentRackIndex) and Color3.fromRGB(35,120,70) or Color3.fromRGB(18,18,18)
        btn.TextColor3 = Color3.fromRGB(230,230,230)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 12
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Text = string.format("%d. %s", idx, name)
        btn.Parent = rackList

        btn.MouseButton1Click:Connect(function()
            currentRackIndex = idx
            local success = pcall(function()
                teleportCharacterToPart(target)
            end)
            -- refresh highlight
            updateRackListUI()
        end)
    end

    rackLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        rackList.CanvasSize = UDim2.new(0, 0, 0, rackLayout.AbsoluteContentSize.Y + 8)
    end)
    rackList.CanvasSize = UDim2.new(0, 0, 0, rackLayout.AbsoluteContentSize.Y + 8)
end

