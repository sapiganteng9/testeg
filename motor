-- ==========================================
-- PROXIMITY PROMPT TRIGGER UTILITY (BARU)
-- ==========================================
local function triggerPromptOnTarget(part)
    if not part then return end
    -- cari prompt di dalam part terlebih dahulu
    local prompt = nil
    for _, obj in ipairs(part:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            prompt = obj
            break
        end
    end
    -- jika tidak ditemukan, cari di parent (model)
    if not prompt and part.Parent then
        for _, obj in ipairs(part.Parent:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                prompt = obj
                break
            end
        end
    end
    if prompt then
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(math.max(0.05, prompt.HoldDuration or 0.1))
            prompt:InputHoldEnd()
        end)
    end
end

-- ==========================================
-- TELEPORT UTILITY (DIUBAH: tunggu tween selesai lalu trigger jika aktif)
-- ==========================================
local function teleportCharacterToPart(part)
    if not part or not part:IsA("BasePart") then return end
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    local targetCFrame = part.CFrame + Vector3.new(0, HEIGHT, 0)
    local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local createdTween
    local successCreate, created = pcall(function()
        return TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    end)
    if successCreate and created then
        local okPlay = pcall(function() created:Play() end)
        if okPlay then
            -- tunggu selesai atau timeout kecil
            local finished = false
            local conn
            conn = created.Completed:Connect(function()
                finished = true
            end)
            local t = 0
            while t < 0.45 and not finished do
                local dt = RunService.Heartbeat:Wait()
                t = t + dt
            end
            if conn then conn:Disconnect() end
        else
            hrp.CFrame = targetCFrame
        end
    else
        hrp.CFrame = targetCFrame
    end

    -- setelah teleport selesai, auto-trigger jika aktif
    if autoTriggerAfterTeleport then
        triggerPromptOnTarget(part)
    end
end

-- ==========================================
-- RAK TARGETS (cari di workspace.rak)
-- ==========================================
local function getRackTargets()
    local root = workspace:FindFirstChild("rak") or workspace:FindFirstChild("Rak")
    if not root then
        -- fallback: cari folder bernama rak di descendants
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Folder") and obj.Name:lower() == "rak" then
                root = obj
                break
            end
        end
    end
    if not root then
        return {}
    end

    local seen = {}
    local targets = {}

    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            local targetPart = nil
            if parent:IsA("BasePart") then
                targetPart = parent
            elseif parent:IsA("Model") then
                targetPart = parent.PrimaryPart
                if not targetPart then
                    for _, c in ipairs(parent:GetChildren()) do
                        if c:IsA("BasePart") then
                            targetPart = c
                            break
                        end
                    end
                end
            end
            if targetPart and not seen[targetPart] then
                table.insert(targets, targetPart)
                seen[targetPart] = true
            end
        elseif obj:IsA("BasePart") and obj.Name:lower():find("rak") then
            if not seen[obj] then
                table.insert(targets, obj)
                seen[obj] = true
            end
        end
    end

    -- juga periksa children langsung di root
    for _, child in ipairs(root:GetChildren()) do
        if child:IsA("Model") then
            local candidate = child.PrimaryPart
            if not candidate then
                for _, c in ipairs(child:GetChildren()) do
                    if c:IsA("BasePart") then
                        candidate = c
                        break
                    end
                end
            end
            if candidate and not seen[candidate] then
                table.insert(targets, candidate)
                seen[candidate] = true
            end
        elseif child:IsA("BasePart") and not seen[child] then
            table.insert(targets, child)
            seen[child] = true
        end
    end

    return targets
end

local function refreshRackTargets()
    rackTargets = getRackTargets()
    if #rackTargets == 0 then currentRackIndex = 1 end
    if currentRackIndex > #rackTargets then currentRackIndex = 1 end
    updateRackListUI()
end

local function teleportNextRack()
    refreshRackTargets()
    if #rackTargets == 0 then return end
    if currentRackIndex > #rackTargets then currentRackIndex = 1 end
    local target = rackTargets[currentRackIndex]
    if target then
        teleportCharacterToPart(target)
    end
    currentRackIndex = currentRackIndex + 1
    if currentRackIndex > #rackTargets then currentRackIndex = 1 end
    updateRackListUI()
end

local function startAutoRack()
    if rackCoroutine then return end
    autoRack = true
    btnToggleRack.BackgroundColor3 = Color3.fromRGB(35, 120, 70)
    btnToggleRack.Text = "AUTO RACK (G) - ON"
    rackCoroutine = coroutine.create(function()
        while autoRack and gui.Parent do
            teleportNextRack()
            local t = 0
            while t < TELEPORT_DELAY and autoRack and gui.Parent do
                local dt = RunService.Heartbeat:Wait()
                t = t + dt
            end
        end
        rackCoroutine = nil
        autoRack = false
        if gui.Parent then
            btnToggleRack.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
            btnToggleRack.Text = "AUTO RACK (G) - OFF"
        end
    end)
    coroutine.resume(rackCoroutine)
end

local function stopAutoRack()
    autoRack = false
    rackCoroutine = nil
    if gui.Parent then
        btnToggleRack.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
        btnToggleRack.Text = "AUTO RACK (G) - OFF"
    end
end

-- ==========================================
-- FIND MEJAMAKAN
-- ==========================================
local function findMejaMakanPart()
    local targetName = "mejamakan"
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name:lower() == targetName then
            if obj:IsA("BasePart") then
                return obj
            elseif obj:IsA("Model") then
                if obj.PrimaryPart then return obj.PrimaryPart end
                for _, c in ipairs(obj:GetChildren()) do
                    if c:IsA("BasePart") then return c end
                end
            end
        end
    end
    -- fallback: contains the word "meja" and "makan"
    for _, obj in ipairs(workspace:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("meja") and n:find("makan") then
            if obj:IsA("BasePart") then return obj end
            if obj:IsA("Model") then
                if obj.PrimaryPart then return obj.PrimaryPart end
                for _, c in ipairs(obj:GetChildren()) do
                    if c:IsA("BasePart") then return c end
                end
            end
        end
    end
    return nil
end

