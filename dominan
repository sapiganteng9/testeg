-- ==========================================
-- GET ROOT PART
-- ==========================================

local function getRootPart()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

-- ==========================================
-- AUTO TELEPORT LOOP
-- ==========================================

task.spawn(function()
    while gui.Parent do
        if autoTeleport then
            local rootPart = getRootPart()
            if rootPart then
                for _, spawnName in ipairs(materialOrder) do
                    if not autoTeleport then break end
                    if selectedMaterials[spawnName] then
                        for _, item in ipairs(spawnFolder:GetChildren()) do
                            if not autoTeleport then break end
                            if item.Name == spawnName and item.Parent then
                                local success, cf = pcall(function()
                                    return item:GetPivot()
                                end)
                                if success and cf then
                                    rootPart.CFrame = cf + Vector3.new(0, HEIGHT, 0)
                                    task.wait(TELEPORT_DELAY)
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.2)
    end
end)

-- ==========================================
-- AUTO PROXIMITY LOOP
-- ==========================================

task.spawn(function()
    while gui.Parent do
        if autoPrompt then
            local rootPart = getRootPart()
            if rootPart then
                for _, instance in ipairs(workspace:GetDescendants()) do
                    if not autoPrompt then break end
                    if instance:IsA("ProximityPrompt") then
                        local targetPart = instance.Parent
                        if targetPart and targetPart:IsA("BasePart") and rootPart.Parent then
                            local distance = (targetPart.Position - rootPart.Position).Magnitude
                            if distance <= instance.MaxActivationDistance then
                                pcall(function()
                                    instance:InputHoldBegin()
                                    task.wait(instance.HoldDuration)
                                    instance:InputHoldEnd()
                                end)
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)

