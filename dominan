-- ==========================================
-- CHECKBOX CREATION
-- ==========================================

local checkboxButtons = {}

local function createCheckbox(displayName, spawnName)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 32)
    button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 12
    button.Font = Enum.Font.JetBrains
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.Parent = list
    
    checkboxButtons[spawnName] = button

    local function update()
        if selectedMaterials[spawnName] then
            button.Text = "✓  " .. displayName
            button.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        else
            button.Text = "☐  " .. displayName
            button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        end
    end

    button.MouseButton1Click:Connect(function()
        selectedMaterials[spawnName] = not selectedMaterials[spawnName]
        update()
    end)

    update()
end

for displayName, spawnName in pairs(materials) do
    createCheckbox(displayName, spawnName)
end

