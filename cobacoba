-- ===== DRAGGABLE TITLE BAR =====
local dragging = false
local dragStart = nil
local startPos = nil

local function clampPosition(x, y, frameSize)
    local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
    local maxX = viewport.X - frameSize.X
    local maxY = viewport.Y - frameSize.Y
    local nx = math.clamp(x, 0, math.max(0, maxX))
    local ny = math.clamp(y, 0, math.max(0, maxY))
    return nx, ny
end

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.AbsolutePosition

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        local newX = startPos.X + delta.X
        local newY = startPos.Y + delta.Y
        local nx, ny = clampPosition(newX, newY, mainFrame.AbsoluteSize)
        mainFrame.Position = UDim2.new(0, nx, 0, ny)
    end
end)

