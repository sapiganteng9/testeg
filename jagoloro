-- ==========================================
local checkboxButtons = {}

local function createCheckbox(displayName, spawnName)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 32)
    button.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    button.TextColor3 = Color3.fromRGB(230, 230, 230)
    button.TextSize = 12
    button.Font = Enum.Font.Gotham
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.Parent = list

    checkboxButtons[spawnName] = button

    local function update()
        if selectedMaterials[spawnName] then
            button.Text = "☑  " .. displayName
            button.BackgroundColor3 = Color3.fromRGB(30, 90, 55) -- aktif: gelap hijau
        else
            button.Text = "☐  " .. displayName
            button.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
        end
    end

    button.MouseButton1Click:Connect(function()
        selectedMaterials[spawnName] = not selectedMaterials[spawnName]
        update()
    end)

    update()
end

for displayName, spawnName in pairs(materials) do
    createCheckbox(displayName, spawnName)
end

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    list.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
