-- ==========================================
-- ROOT PART
-- ==========================================
local function getRootPart()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

-- ==========================================
-- HELPER: CEK ADA BAHAN DI SPAWN (versi lebih andal)
-- ==========================================
local function materialPresentAtSpawn(spawn)
    local ok, pivot = pcall(function() return spawn:GetPivot() end)
    if not ok or not pivot then
        return false
    end
    local spawnPos = pivot.Position
    local CHECK_RADIUS = 4

    -- gunakan OverlapParams untuk mengecualikan marker spawn di folder SpawnBahan
    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Blacklist
    overlapParams.FilterDescendantsInstances = {spawnFolder}

    local parts = {}
    local successParts, resultParts = pcall(function()
        return workspace:GetPartBoundsInRadius(spawnPos, CHECK_RADIUS, overlapParams)
    end)

    if successParts and resultParts then
        parts = resultParts
    end

    -- jika ada BasePart di radius (dan bukan bagian dari karakter pemain), anggap ada bahan
    for _, part in ipairs(parts) do
        if part and part:IsA("BasePart") then
            local ancestorModel = part:FindFirstAncestorOfClass("Model")
            if ancestorModel then
                if not Players:GetPlayerFromCharacter(ancestorModel) then
                    return true
                end
            else
                return true
            end
        end
    end

    -- fallback: cek model yang tidak berada di spawnFolder tetapi pivotnya dekat
    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") and not model:IsDescendantOf(spawnFolder) then
            local ok2, mcf = pcall(function() return model:GetPivot() end)
            if ok2 and mcf and (mcf.Position - spawnPos).Magnitude <= CHECK_RADIUS then
                if not tostring(model.Name):match("^Spawn") then
                    return true
                end
            end
        end
    end

    -- fallback 2: periksa apakah spawn memiliki anak yang tampak seperti item nyata
    for _, ch in ipairs(spawn:GetChildren()) do
        if ch:IsA("BasePart") then
            if not tostring(ch.Name):match("^Spawn") then
                return true
            end
        elseif ch:IsA("Model") then
            if not tostring(ch.Name):match("^Spawn") then
                -- jika model berisi parts non-marker, anggap ada bahan
                for _, sub in ipairs(ch:GetDescendants()) do
                    if sub:IsA("BasePart") and not tostring(sub.Name):match("^Spawn") then
                        return true
                    end
                end
            end
        else
            -- jika ada anak lain (mis. MeshPart dll) yang bukan StringValue/ObjectValue, anggap ada
            if not ch:IsA("StringValue") and not ch:IsA("ObjectValue") then
                if not tostring(ch.Name):match("^Spawn") then
                    return true
                end
            end
        end
    end

    return false
end

-- ==========================================
-- AUTO TELEPORT
-- ==========================================
task.spawn(function()
    while gui.Parent do
        if autoTeleport then
            local rootPart = getRootPart()
            if rootPart then
                for _, spawnName in ipairs(materialOrder) do
                    if not autoTeleport then break end
                    if selectedMaterials[spawnName] then
                        for _, item in ipairs(spawnFolder:GetChildren()) do
                            if not autoTeleport then break end
                            if item.Name == spawnName and item.Parent then
                                local present = false
                                pcall(function()
                                    present = materialPresentAtSpawn(item)
                                end)

                                if not present then
                                    -- tidak ada bahan saat ini: lewati teleport
                                else
                                    local success, cf = pcall(function()
                                        return item:GetPivot()
                                    end)
                                    if success and cf then
                                        rootPart.CFrame = cf + Vector3.new(0, HEIGHT, 0)
                                        task.wait(TELEPORT_DELAY)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.2)
    end
end)

-- ==========================================
-- AUTO PROXIMITY
-- ==========================================
task.spawn(function()
    while gui.Parent do
        if autoPrompt then
            local rootPart = getRootPart()
            if rootPart then
                for _, instance in ipairs(workspace:GetDescendants()) do
                    if not autoPrompt then break end
                    if instance:IsA("ProximityPrompt") then
                        local targetPart = instance.Parent
                        if targetPart and targetPart:IsA("BasePart") and rootPart.Parent then
                            local distance = (targetPart.Position - rootPart.Position).Magnitude
                            if distance <= instance.MaxActivationDistance then
                                pcall(function()
                                    instance:InputHoldBegin()
                                    task.wait(instance.HoldDuration)
                                    instance:InputHoldEnd()
                                end)
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)

